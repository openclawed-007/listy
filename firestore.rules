rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isShoppingItemValid(data) {
      return data.userId is string
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 500
        && data.completed is bool
        && (!('quantity' in data) || (data.quantity is string && data.quantity.size() <= 40))
        && (!('category' in data) || (data.category is string && data.category.size() <= 80))
        && (!('listId' in data) || (data.listId is string && data.listId.size() <= 200))
        && (!('listName' in data) || (data.listName is string && data.listName.size() <= 120))
        && (!('sharedFromUserId' in data) || (data.sharedFromUserId is string && data.sharedFromUserId.size() <= 128));
    }

    match /shoppingItems/{itemId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && isShoppingItemValid(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && isShoppingItemValid(request.resource.data);
    }

    function arePermissionsValid(perms) {
      return perms is map
        && (!('toggle' in perms) || perms.toggle is bool)
        && (!('add' in perms) || perms.add is bool)
        && (!('remove' in perms) || perms.remove is bool);
    }

    function isSharedListValid(data, ownerId) {
      return data.ownerId == ownerId
        && data.ownerName is string
        && data.ownerName.size() <= 120
        && data.items is list
        && data.items.size() <= 500
        && (!('allowEdits' in data) || data.allowEdits is bool)
        && (!('allowAnonymousEdits' in data) || data.allowAnonymousEdits is bool)
        && (!('permissions' in data) || arePermissionsValid(data.permissions));
    }

    // Whether collaborators are allowed to do anything at all on this list.
    function collaboratorsEnabled(data) {
      return data.allowEdits == true
        && 'permissions' in data
        && data.permissions is map;
    }

    // True when the signed-in user is anonymous (no federated/email identity).
    function isAnonymousUser() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Read a single granular permission, defaulting missing keys to false.
    function permGranted(data, key) {
      return key in data.permissions && data.permissions[key] == true;
    }

    // The structural invariants every collaborator write must satisfy:
    // only `items` (a well-formed list under the cap) and `updatedAt` may
    // change; ownership, naming, permissions and the sharing flags are frozen.
    function isCollaboratorStructureValid(existing, incoming) {
      return collaboratorsEnabled(existing)
        && collaboratorsEnabled(incoming)
        && incoming.ownerId == existing.ownerId
        && incoming.ownerName == existing.ownerName
        && incoming.permissions == existing.permissions
        && incoming.allowEdits == existing.allowEdits
        && incoming.allowAnonymousEdits == existing.allowAnonymousEdits
        && incoming.items is list
        && incoming.items.size() <= 500
        && incoming.diff(existing).affectedKeys().hasOnly(['items', 'updatedAt']);
    }

    // Map the change in the items array to the permission it requires, and
    // enforce that permission server-side rather than trusting the client:
    //  - growing the list (a net add)    -> requires `add`
    //  - shrinking the list (a removal)  -> requires `remove`
    //  - same length (a toggle/edit)     -> requires `toggle`
    // This is deliberately coarse (it keys off list length) but it guarantees a
    // collaborator can never perform a class of change the owner did not grant.
    function isCollaboratorChangeAllowed(existing, incoming) {
      return (incoming.items.size() > existing.items.size()
                && permGranted(existing, 'add'))
        || (incoming.items.size() < existing.items.size()
                && permGranted(existing, 'remove'))
        || (incoming.items.size() == existing.items.size()
                && permGranted(existing, 'toggle'));
    }

    // A signed-in (non-owner) collaborator may make any granted change.
    function isCollaboratorListUpdate(existing, incoming) {
      return isCollaboratorStructureValid(existing, incoming)
        && isCollaboratorChangeAllowed(existing, incoming);
    }

    // An anonymous visitor may only edit when the owner opted in via
    // `allowAnonymousEdits`, and may only toggle or add (never remove): a
    // shrinking items array from an anonymous writer is always rejected.
    function isAnonymousListUpdate(existing, incoming) {
      return existing.allowAnonymousEdits == true
        && isCollaboratorStructureValid(existing, incoming)
        && incoming.items.size() >= existing.items.size()
        && isCollaboratorChangeAllowed(existing, incoming);
    }

    match /sharedLists/{ownerId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == ownerId
        && request.resource.data.ownerId == request.auth.uid
        && isSharedListValid(request.resource.data, ownerId);
      allow update: if request.auth != null
        && (
          (
            request.auth.uid == ownerId
            && request.resource.data.ownerId == ownerId
            && isSharedListValid(request.resource.data, ownerId)
          )
          || (
            request.auth.uid != ownerId
            && !isAnonymousUser()
            && isCollaboratorListUpdate(resource.data, request.resource.data)
          )
          || (
            request.auth.uid != ownerId
            && isAnonymousUser()
            && isAnonymousListUpdate(resource.data, request.resource.data)
          )
        );
      allow delete: if request.auth != null
        && request.auth.uid == ownerId;
    }
  }
}
