rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isShoppingItemValid(data) {
      return data.userId is string
        && data.userId.size() > 0
        && data.userId.size() <= 128
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 500
        && data.completed is bool
        && (!('quantity' in data) || (data.quantity is string && data.quantity.size() <= 40))
        && (!('category' in data) || (data.category is string && data.category.size() <= 80))
        && (!('note' in data) || (data.note is string && data.note.size() <= 120))
        && (!('listId' in data) || (data.listId is string && data.listId.size() <= 200))
        && (!('listName' in data) || (data.listName is string && data.listName.size() <= 120))
        && (!('sharedFromUserId' in data) || (data.sharedFromUserId is string && data.sharedFromUserId.size() <= 128))
        && (!('sharedSourceItemId' in data) || (data.sharedSourceItemId is string && data.sharedSourceItemId.size() <= 128))
        // Important flag + manual sort order (undo restore writes these too).
        && (!('important' in data) || data.important is bool)
        && (!('sortOrder' in data) || data.sortOrder is number)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /shoppingItems/{itemId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      // create covers first write and undo-restore via setDoc on a deleted id.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && isShoppingItemValid(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && isShoppingItemValid(request.resource.data);
    }

    function arePermissionsValid(perms) {
      return perms is map
        && (!('toggle' in perms) || perms.toggle is bool)
        && (!('add' in perms) || perms.add is bool)
        && (!('remove' in perms) || perms.remove is bool);
    }

    function isSharedListValid(data, ownerId) {
      return data.ownerId == ownerId
        && data.ownerName is string
        && data.ownerName.size() <= 120
        && data.items is list
        && data.items.size() <= 500
        && (!('allowEdits' in data) || data.allowEdits is bool)
        && (!('permissions' in data) || arePermissionsValid(data.permissions))
        // Short join code (8 chars, no 0/O/1/I/L). Optional for older docs.
        && (!('shareCode' in data) || (
          data.shareCode is string
          && data.shareCode.matches('^[2-9A-HJ-NP-Z]{8}$')
        ));
    }

    // Public lookup: share code -> ownerId. Create/delete only by the owner;
    // no listing (so codes cannot be enumerated), no updates (immutable map).
    match /shareCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && code.matches('^[2-9A-HJ-NP-Z]{8}$')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId', 'createdAt']);
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Whether collaborators are allowed to do anything at all on this list.
    function collaboratorsEnabled(data) {
      return data.allowEdits == true
        && 'permissions' in data
        && data.permissions is map;
    }

    // Size-based guards for collaborator permission flags.
    // Full per-item content checks are not practical in rules without
    // subcollections; these still block clear violations (e.g. adding when
    // only toggle is granted). Finer limits remain client-enforced.
    function collaboratorSizeAllowed(existing, incoming) {
      let perms = existing.permissions;
      let oldN = existing.items.size();
      let newN = incoming.items.size();
      let canAdd = perms.add == true;
      let canRemove = perms.remove == true;
      let canToggle = perms.toggle == true;
      // No add → cannot grow; no remove → cannot shrink; need at least one flag.
      return (canAdd || canRemove || canToggle)
        && (canAdd || newN <= oldN)
        && (canRemove || newN >= oldN);
    }

    // A collaborator (signed-in, non-owner) may change the `items` array while
    // sharing + editing is enabled. The owner identity, name and the
    // permissions map must stay exactly as the owner left them; only `items`
    // and `updatedAt` may change, and the list must stay well-formed.
    function isCollaboratorListUpdate(existing, incoming) {
      return collaboratorsEnabled(existing)
        && collaboratorsEnabled(incoming)
        && incoming.ownerId == existing.ownerId
        && incoming.ownerName == existing.ownerName
        && incoming.permissions == existing.permissions
        && incoming.allowEdits == existing.allowEdits
        && incoming.items is list
        && incoming.items.size() <= 500
        && collaboratorSizeAllowed(existing, incoming)
        && incoming.diff(existing).affectedKeys().hasOnly(['items', 'updatedAt']);
    }

    match /sharedLists/{ownerId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == ownerId
        && request.resource.data.ownerId == request.auth.uid
        && isSharedListValid(request.resource.data, ownerId);
      allow update: if request.auth != null
        && (
          (
            request.auth.uid == ownerId
            && request.resource.data.ownerId == ownerId
            && isSharedListValid(request.resource.data, ownerId)
          )
          || (
            request.auth.uid != ownerId
            && isCollaboratorListUpdate(resource.data, request.resource.data)
          )
        );
      allow delete: if request.auth != null
        && request.auth.uid == ownerId;
    }

    function isTimeString(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isRemindWhen(value) {
      return value == 'day_of' || value == 'day_before' || value == 'both';
    }

    // Per-user preferences (shopping reminders, interface). Owner-only.
    function isShoppingRemindersValid(value) {
      return value is map
        && value.enabled is bool
        && value.days is list
        && value.days.size() <= 7
        && isTimeString(value.shopTime)
        && isTimeString(value.notifyTime)
        && isRemindWhen(value.when);
    }

    function isInterfacePrefsValid(value) {
      return value is map
        && (!('emptyTips' in value) || value.emptyTips is bool)
        && (!('addHints' in value) || value.addHints is bool)
        && (!('onboardingCopy' in value) || value.onboardingCopy is bool)
        && (!('sortHints' in value) || value.sortHints is bool)
        && (!('shoppingBanners' in value) || value.shoppingBanners is bool)
        && (!('progressBar' in value) || value.progressBar is bool)
        && (!('importantStars' in value) || value.importantStars is bool)
        && (!('brandLogo' in value) || value.brandLogo is bool)
        && (!('shareChangeNotices' in value) || value.shareChangeNotices is bool)
        && (!('displayScale' in value) || (value.displayScale is number
          && value.displayScale >= 80
          && value.displayScale <= 130));
    }

    function isUserListEntryValid(entry) {
      return entry is map
        && entry.id is string
        && entry.id.size() > 5
        && entry.id.size() <= 80
        && entry.id.matches('^list_.+')
        && entry.name is string
        && entry.name.size() > 0
        && entry.name.size() <= 40
        && (!('createdAt' in entry) || entry.createdAt is number);
    }

    function isUserListsValid(value) {
      return value is list
        && value.size() <= 16
        && (value.size() < 1 || isUserListEntryValid(value[0]))
        && (value.size() < 2 || isUserListEntryValid(value[1]))
        && (value.size() < 3 || isUserListEntryValid(value[2]))
        && (value.size() < 4 || isUserListEntryValid(value[3]))
        && (value.size() < 5 || isUserListEntryValid(value[4]))
        && (value.size() < 6 || isUserListEntryValid(value[5]))
        && (value.size() < 7 || isUserListEntryValid(value[6]))
        && (value.size() < 8 || isUserListEntryValid(value[7]))
        && (value.size() < 9 || isUserListEntryValid(value[8]))
        && (value.size() < 10 || isUserListEntryValid(value[9]))
        && (value.size() < 11 || isUserListEntryValid(value[10]))
        && (value.size() < 12 || isUserListEntryValid(value[11]))
        && (value.size() < 13 || isUserListEntryValid(value[12]))
        && (value.size() < 14 || isUserListEntryValid(value[13]))
        && (value.size() < 15 || isUserListEntryValid(value[14]))
        && (value.size() < 16 || isUserListEntryValid(value[15]));
    }

    match /userSettings/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && (!('shoppingReminders' in request.resource.data)
          || isShoppingRemindersValid(request.resource.data.shoppingReminders))
        && (!('interface' in request.resource.data)
          || isInterfacePrefsValid(request.resource.data.interface))
        && (!('lists' in request.resource.data)
          || isUserListsValid(request.resource.data.lists));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
