rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isShoppingItemValid(data) {
      return data.userId is string
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 500
        && data.completed is bool
        && (!('quantity' in data) || (data.quantity is string && data.quantity.size() <= 40))
        && (!('category' in data) || (data.category is string && data.category.size() <= 80))
        && (!('listId' in data) || (data.listId is string && data.listId.size() <= 200))
        && (!('listName' in data) || (data.listName is string && data.listName.size() <= 120))
        && (!('sharedFromUserId' in data) || (data.sharedFromUserId is string && data.sharedFromUserId.size() <= 128));
    }

    match /shoppingItems/{itemId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && isShoppingItemValid(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && isShoppingItemValid(request.resource.data);
    }

    function isSharedListValid(data, ownerId) {
      return data.ownerId == ownerId
        && data.ownerName is string
        && data.ownerName.size() <= 120
        && data.items is list
        && data.items.size() <= 500
        && (!('allowEdits' in data) || data.allowEdits is bool);
    }

    // A collaborator (signed-in, non-owner) may only flip the `completed`
    // flags of existing items while edits are enabled. Everything else
    // (ownerId, ownerName, allowEdits, item text/quantity/category and the
    // item count) must stay exactly as the owner left it.
    function isCollaboratorCompletionUpdate(existing, incoming) {
      return existing.allowEdits == true
        && incoming.allowEdits == true
        && incoming.ownerId == existing.ownerId
        && incoming.ownerName == existing.ownerName
        && incoming.items is list
        && incoming.items.size() == existing.items.size()
        && incoming.diff(existing).affectedKeys().hasOnly(['items', 'updatedAt']);
    }

    match /sharedLists/{ownerId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == ownerId
        && request.resource.data.ownerId == request.auth.uid
        && isSharedListValid(request.resource.data, ownerId);
      allow update: if request.auth != null
        && (
          (
            request.auth.uid == ownerId
            && request.resource.data.ownerId == ownerId
            && isSharedListValid(request.resource.data, ownerId)
          )
          || (
            request.auth.uid != ownerId
            && isCollaboratorCompletionUpdate(resource.data, request.resource.data)
          )
        );
      allow delete: if request.auth != null
        && request.auth.uid == ownerId;
    }
  }
}
