{
  "name": "cartlink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm install && vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "test": "vitest run --exclude src/firestore.rules.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project cartlink-rules-test 'vitest run src/firestore.rules.test.ts'",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "lucide-react": "^1.27.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.28.1",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.5"
  }
}
