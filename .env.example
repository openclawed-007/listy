VITE_FIREBASE_API_KEY=YOUR_API_KEY
# Prefer your custom domain (e.g. cartlink.co.uk) so Google sign-in
# doesn't flash *.firebaseapp.com. Must be on Firebase Hosting + Authorized domains.
# Fallback: YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=cartlink.co.uk
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# App Check (reCAPTCHA v3 site key from Firebase Console -> App Check)
# Leave blank to disable App Check (dev/local).
VITE_RECAPTCHA_SITE_KEY=
# Optional: paste a Firebase App Check debug token here for local dev only.
VITE_APPCHECK_DEBUG_TOKEN=
